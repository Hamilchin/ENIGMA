# Copy to .env and fill in. .env is gitignored. Keys are read by the orchestrator
# only — they are NEVER injected into the browser context the agent drives.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: GitHub token to raise the unauthenticated API rate limit (60/hr -> 5000/hr)
# used by the corpus cloner. Read-only / public scope is enough.
GITHUB_TOKEN=
