{
  "name": "js13k25",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist && mkdir dist && rimraf prod && mkdir prod",
    "bundle": "esbuild src/app.js --bundle --minify --target=es2018 --legal-comments=none --charset=utf8 --outfile=dist/app.js",
    "zip": "bestzip dist/game.zip prod/*.*",
    "check-size": "node tools/size-check.js",
    "start": "parcel src/index.html src/editor.html src/overview.html",
    "build": "npm run clean && parcel build src/index.html --no-source-maps --public-url ./ --dist-dir prod && npm run zip && npm run check-size"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "bestzip": "^2.2.1",
    "parcel": "^2.15.4",
    "rimraf": "^6.0.1"
  }
}